[Unit]
Description=PinSign Visual Design Pin Review, Revision Cap & Launch Sign-Off Server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pinsign
EnvironmentFile=/etc/pinsign/.env
ExecStart=/usr/bin/node --no-warnings /opt/pinsign/server/index.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
